# Optional: shared adventures, calls and server-authoritative actions.
# Get the URL and a database token from your own Turso account.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Optional: private object storage for shared tracks. Without it, shared audio uses Turso chunks automatically.
# Compatible with Cloudflare R2 or Amazon S3. R2 example: https://ACCOUNT_ID.r2.cloudflarestorage.com
MYOWNDEX_S3_ENDPOINT=
MYOWNDEX_S3_BUCKET=
MYOWNDEX_S3_ACCESS_KEY_ID=
MYOWNDEX_S3_SECRET_ACCESS_KEY=
MYOWNDEX_S3_REGION=auto

# Optional: custom WebRTC TURN servers (public configuration for browsers).
# Supply your own credentials; never use database/storage secrets here.
# NEXT_PUBLIC_MYOWNDEX_ICE_SERVERS=[{"urls":"turn:turn.example.com:3478","username":"trainer","credential":"replace-me"}]
